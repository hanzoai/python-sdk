{
  "rule": "GET /v1/models lists the decision models under `data` and keeps its `models` key empty; hanzo_kai.jev lists `data` in Jev's shape.",
  "cases": [
    {
      "path": "native",
      "send": [
        {
          "call": "models"
        }
      ],
      "expect": {
        "status": 200,
        "checks": [
          "data"
        ]
      }
    },
    {
      "path": "compat",
      "send": [
        {
          "call": "models"
        }
      ],
      "expect": {
        "status": 200,
        "checks": [
          "catalog",
          "request_id"
        ]
      }
    }
  ]
}
